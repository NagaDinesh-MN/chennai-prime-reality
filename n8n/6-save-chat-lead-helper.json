    {
      "id": "1e691f4b-81a1-4328-b2c5-8bd501ec8160",
      "name": "Check Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Checks a lead from the website chat before it is saved.\nconst q = $('When Called by Agent').first().json;\nconst s = v => (v === undefined || v === null) ? '' : String(v).trim();\nconst name = s(q.name);\nconst digits = s(q.phone).replace(/[^0-9]/g, '');\nconst email = s(q.email);\nconst problems = [];\nif (name.length < 2) problems.push(\"the visitor's name is missing\");\nif (digits.length < 10 || digits.length > 13) problems.push('a valid phone number (10 digits, or with country code) is missing');\nif (email && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) problems.push('the email address looks wrong');\nif (problems.length) return [{ json: { ok: false, reason: problems.join('; ') } }];\nconst phone = digits.length === 10 ? '+91 ' + digits : (digits.length === 12 && digits.startsWith('91')) ? '+91 ' + digits.slice(2) : '+' + digits;\nconst interest = s(q.interest).toLowerCase().includes('rent') ? 'rent a villa' : 'buy property';\nconst parts = [\n  'Wants to ' + interest,\n  s(q.dates) && 'Dates: ' + s(q.dates),\n  s(q.guests) && 'Guests: ' + s(q.guests),\n  s(q.request) && 'Request: ' + s(q.request),\n  email && 'Email: ' + email,\n].filter(Boolean);\nreturn [{ json: {\n  ok: true,\n  enquiry_id: 'chat:' + (s(q.session_id) || Date.now()),\n  received_at: $now.toISO(),\n  source: 'website chat',\n  customer_name: name,\n  contact: phone,\n  message: parts.join(' | '),\n  property_type: s(q.property_type),\n  location: s(q.location),\n  budget: s(q.budget),\n  matching_villa_ids: s(q.interested_in),\n  enquiry_status: 'new',\n  response_status: 'follow_up_needed',\n  requires_human_followup: 'true',\n  interest,\n  email,\n} }];\n"
      }
    },
